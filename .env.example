# Base URL of your FreeITSM install (https only; http allowed only for localhost). No trailing /api/v1.
FREEITSM_BASE_URL=https://itsm.example.com
# API key created in FreeITSM (System > API). Keys look like fitsm_...  Never commit a real key.
FREEITSM_API_KEY=
# Comma-separated tiers to expose: read | write | admin (default: read)
FREEITSM_TOOL_TIERS=read
# env = key from FREEITSM_API_KEY; gateway = key from the X-FreeITSM-Key header (HTTP only)
AUTH_MODE=env
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1
# Required for the HTTP transport (generate with: openssl rand -hex 32)
CONDUIT_S2S_SECRET=
MCP_ALLOW_INSECURE_DEV=0
# Optional PEM CA bundle for a private CA
FREEITSM_CA_CERT_FILE=
LOG_LEVEL=info
